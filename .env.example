# VicRoot Insights — environment template
# Copy to `.env` and fill in real values. `.env` is gitignored.

# Optional: merge overrides into notebook params (JSON object, one line)
# VICROOT_PARAMS_JSON={"snapshot_date":"2026-04-24","environment":"dev"}

# Optional: override API base URLs for local testing
# VICROOT_API_BASE_URL_COM=
# VICROOT_API_BASE_URL_SOIL=
# VICROOT_API_BASE_URL_BOM=

# API authentication (many CoM datasets are public; set only if required)
VICROOT_COM_APP_TOKEN=

# Agriculture Victoria or related soil API
VICROOT_SOIL_API_KEY=
VICROOT_SOIL_API_SUBSCRIPTION_KEY=

# BOM / Data.vic — only if your endpoint requires a key
VICROOT_BOM_API_KEY=

# OpenWeather API
VICROOT_OPENWEATHER_API_KEY=
VICROOT_OPENWEATHER_SECRET_NAME=openweather-api-key
VICROOT_WEATHER_API_PROVIDER=open_meteo_archive
VICROOT_WEATHER_YEARS_CSV=2022,2023,2024,2025

# Azure identity (local scripts / tests only — in Fabric use workspace identity + Key Vault)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
VICROOT_KEY_VAULT_NAME=
# Optional full URL if you prefer not to use key vault name
# VICROOT_KEY_VAULT_URL=https://<vault-name>.vault.azure.net
# Optional Fabric linked service / connection name for notebook utils getSecret
# VICROOT_KEY_VAULT_LINKED_SERVICE=
# Optional Fabric connection id for notebookutils.credentials.getSecretWithConnection
VICROOT_KEY_VAULT_CONNECTION_ID=5173c532-426a-498f-9730-90700afe13a6

# Fabric / OneLake (optional local tooling)
# FABRIC_WORKSPACE_ID=
# FABRIC_LAKEHOUSE_ID=
# ONELAKE_ACCOUNT_URL=

