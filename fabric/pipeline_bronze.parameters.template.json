    "com_dataset_soil_locations": { "type": "string", "default": "soil-sensor-locations" },
    "soil_zip_input_path": { "type": "string", "default": "Files/medallion/bronze/Soil Sensor Readings - Historical data (2022).zip" },
    "soil_zip_filename_slug": { "type": "string", "default": "soil_sensor_readings_historical_2022.zip" },
    "soil_csv_input_dir": { "type": "string", "default": "Files/medallion/bronze" },
    "soil_csv_file_pattern": { "type": "string", "default": "soil-sensor-readings-historical-data-{year}.csv" }
  }
}
